<%- include('partials/header') %>

<div class="mt-2 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-calendar-range text-danger me-2"></i>Configure Daily Upload Schedule</h2>
            <p class="text-muted mb-0">Theme: <strong><%= theme.theme_name %></strong> &bull; Default Pipeline: <span class="badge <%= theme.strategy === 'ai_video' ? 'bg-primary' : 'bg-danger' %>"><%= theme.strategy === 'ai_video' ? 'AI Video' : 'Shorts Clips' %></span></p>
        </div>
        <a href="/themes" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Back to Themes</a>
    </div>
    
    <div class="yt-card p-4">
        <form method="POST" action="/themes/<%= theme.id %>/configure_schedule">
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label for="posts_per_day" class="form-label fw-bold">Daily Upload Quota (Shorts/Videos per Day):</label>
                    <input type="number" class="form-control" id="posts_per_day" name="posts_per_day" min="1" max="8" 
                           value="<%= schedule && schedule.posts_per_day ? schedule.posts_per_day : 2 %>" required>
                    <small class="text-muted">Recommended for YouTube algorithm: 2-3 Shorts per day.</small>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded border">
                        <small class="text-muted fw-bold d-block mb-1"><i class="bi bi-clock-history text-danger"></i> Peak Viewer Times for YouTube:</small>
                        <span class="badge bg-secondary me-1">11:30 AM</span>
                        <span class="badge bg-secondary me-1">03:30 PM</span>
                        <span class="badge bg-secondary me-1">06:00 PM</span>
                        <span class="badge bg-secondary">08:30 PM</span>
                    </div>
                </div>
            </div>

            <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-clock me-1"></i>Publishing Slot Timings &amp; Media Modes:</h5>
            <div id="time_slots_container" class="mt-3">
                <!-- Time slot inputs generated by JS -->
            </div>
            
            <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-4">
                <a href="/themes" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-yt-red px-4 py-2 fw-bold">
                    <i class="bi bi-check2-circle me-1"></i> Save Daily Schedule
                </button>
            </div>
        </form>
    </div>
</div> 

<script>
document.addEventListener('DOMContentLoaded', function() {
    const postsPerDayInput = document.getElementById('posts_per_day');
    const timeSlotsContainer = document.getElementById('time_slots_container');
    const currentThemeStrategy = ("<%- theme.strategy || 'short_clips' %>");

    let existingScheduleSlots = [];
    <% if (schedule && schedule.scheduled_times_json) { %>
    try {
        let rawJson = <%- JSON.stringify(schedule.scheduled_times_json) %>;
        if (typeof rawJson === 'string' && rawJson.trim() !== '') {
            existingScheduleSlots = JSON.parse(rawJson);
        } else if (Array.isArray(rawJson)) {
            existingScheduleSlots = rawJson;
        }
    } catch (e) {
        console.error("Error parsing existing schedule JSON:", e);
    }
    <% } %>

    const defaultTimes = ['11:30', '15:30', '18:00', '20:30', '09:00', '13:00'];

    function updateTimeSlots(count) {
        if (!timeSlotsContainer) return;
        timeSlotsContainer.innerHTML = ''; 
        if (count > 0 && count <= 8) {
            for (let i = 1; i <= count; i++) {
                const existingSlotData = existingScheduleSlots && existingScheduleSlots[i-1] ? existingScheduleSlots[i-1] : {};
                const currentTime = existingSlotData.time || defaultTimes[(i-1) % defaultTimes.length];
                const currentMediaPref = existingSlotData.media_pref || 'theme_default'; 

                const slotDiv = document.createElement('div');
                slotDiv.classList.add('mb-3', 'p-3', 'border', 'rounded-3', 'bg-light');
                
                slotDiv.innerHTML = `
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-bold text-dark"><i class="bi bi-alarm text-danger me-1"></i> Daily Upload Slot #${i}</span>
                        <span class="badge bg-white text-secondary border">Slot ${i} of ${count}</span>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="time_slot_${i}" class="form-label small fw-bold mb-1">Upload Time (Local Time):</label>
                            <input type="time" class="form-control" id="time_slot_${i}" name="time_slot_${i}" value="${currentTime}" required>
                        </div>
                        <div class="col-md-6">
                            <label for="media_pref_slot_${i}" class="form-label small fw-bold mb-1">Content Mode for this Slot:</label>
                            <select class="form-select" id="media_pref_slot_${i}" name="media_pref_slot_${i}">
                                <option value="theme_default" ${currentMediaPref === 'theme_default' ? 'selected' : ''}>Use Current Theme Strategy (${currentThemeStrategy === 'ai_video' ? 'AI Video' : 'Shorts Clips'})</option>
                                <option value="short_clips" ${currentMediaPref === 'short_clips' ? 'selected' : ''}>Force Short Video Clip Extract (9:16)</option>
                                <option value="ai_video" ${currentMediaPref === 'ai_video' ? 'selected' : ''}>Force Similar AI Video Remake</option>
                            </select>
                        </div>
                    </div>
                `;
                timeSlotsContainer.appendChild(slotDiv);
            }
        }
    }

    if (postsPerDayInput && timeSlotsContainer) {
        postsPerDayInput.addEventListener('input', function() {
            const count = parseInt(this.value, 10);
            if (isNaN(count)) {
                updateTimeSlots(0);
            } else {
                updateTimeSlots(count);
            }
        });
        const initialCount = parseInt(postsPerDayInput.value, 10);
        if (!isNaN(initialCount)) {
            updateTimeSlots(initialCount);
        } else {
            updateTimeSlots(2);
        }
    }
});
</script>

<%- include('partials/footer') %>
