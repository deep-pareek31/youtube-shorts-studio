<%- include('partials/header') %>

<div class="mt-2 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-search text-danger me-2"></i>YouTube Channel &amp; Video Studio Analyzer</h2>
            <p class="text-muted mb-0">Discover top-viewed videos, extract 3-4 viral Shorts clips, or generate matching AI videos with identical lighting &amp; voiceover style.</p>
        </div>
        <a href="/themes" class="btn btn-outline-secondary btn-sm"><i class="bi bi-collection-play me-1"></i> View Existing Themes</a>
    </div>

    <!-- Step 1: Input Channel or Video Link -->
    <div class="yt-card p-4 mb-4">
        <h5 class="fw-bold mb-3"><i class="bi bi-link-45deg text-danger me-1"></i> Step 1: Provide YouTube Channels or Video Links</h5>
        <form method="POST" action="/analyze/fetch" class="row g-3">
            <div class="col-lg-8">
                <label for="channel_or_video_input" class="form-label fw-semibold">YouTube Channel Handle(s), URLs, or Direct Video Links:</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-danger"><i class="bi bi-youtube fs-5"></i></span>
                    <input type="text" class="form-control" id="channel_or_video_input" name="channel_or_video_input" 
                           value="<%= typeof current_input !== 'undefined' ? current_input : '' %>" 
                           placeholder="e.g. @hubermanlab, @veritasium, or https://youtube.com/watch?v=... (comma-separated)" required>
                </div>
                <div class="form-text mt-2">
                    Tip: Try popular channels like <a href="javascript:void(0)" onclick="setInput('@hubermanlab')">@hubermanlab</a>, 
                    <a href="javascript:void(0)" onclick="setInput('@veritasium')">@veritasium</a>, 
                    <a href="javascript:void(0)" onclick="setInput('@aliabdaal')">@aliabdaal</a>, 
                    or <a href="javascript:void(0)" onclick="setInput('https://www.youtube.com/watch?v=gT8eU8qXbZ0')">direct video link</a>.
                </div>
            </div>
            <div class="col-lg-4 d-flex align-items-end">
                <button type="submit" class="btn btn-yt-red w-100 py-2 fw-semibold">
                    <i class="bi bi-lightning-charge me-1"></i> Fetch Top-Viewed &amp; Analyze
                </button>
            </div>
        </form>
    </div>

    <!-- Step 2: Channel Analysis & Top Videos List (If available) -->
    <% if (typeof analyzed_channel !== 'undefined' && analyzed_channel) { %>
    <div class="yt-card p-4 mb-4" style="border-top: 4px solid #065FD4;">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
            <div class="d-flex align-items-center gap-3">
                <div style="width: 54px; height: 54px; border-radius: 50%; background: #CC0000; color: white; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: bold;">
                    <%= analyzed_channel.channel_title.charAt(0) %>
                </div>
                <div>
                    <h4 class="fw-bold mb-0"><%= analyzed_channel.channel_title %></h4>
                    <span class="text-muted small"><%= analyzed_channel.handle %> &bull; <%= analyzed_channel.subscribers %> subscribers &bull; <%= analyzed_channel.total_videos %> videos</span>
                </div>
            </div>
            <span class="badge bg-primary px-3 py-2 fs-6">Channel Analyzed Successfully</span>
        </div>
        <p class="text-secondary small mb-3">
            <strong>Niche / Style Signature:</strong> <%= analyzed_channel.niche_summary %>
        </p>

        <h5 class="fw-bold mb-3 text-dark">Top-Viewed &amp; Highest-Rated Videos</h5>
        <div class="row g-3">
            <% (analyzed_channel.top_videos || []).forEach(function(vid, index) { %>
            <div class="col-md-4">
                <div class="card h-100 border <%= (typeof selected_video !== 'undefined' && selected_video && selected_video.id === vid.id) ? 'border-danger shadow' : '' %>">
                    <div style="position: relative; aspect-ratio: 16/9; background: #222; overflow: hidden;">
                        <img src="<%= vid.thumbnail_url %>" alt="<%= vid.title %>" style="width: 100%; height: 100%; object-fit: cover;">
                        <span class="position-absolute bottom-0 end-0 bg-dark text-white px-2 py-1 m-2 rounded small fw-bold"><%= vid.duration %></span>
                        <span class="position-absolute top-0 start-0 bg-danger text-white px-2 py-1 m-2 rounded small fw-bold">#<%= index + 1 %> Top Video</span>
                    </div>
                    <div class="card-body p-3 d-flex flex-column justify-content-between">
                        <div>
                            <h6 class="fw-bold mb-1 text-dark" style="line-height: 1.3;"><%= vid.title %></h6>
                            <div class="d-flex gap-3 text-muted small mb-2">
                                <span><i class="bi bi-eye text-primary me-1"></i><%= vid.views %></span>
                                <span><i class="bi bi-hand-thumbs-up text-success me-1"></i><%= vid.likes %></span>
                            </div>
                            <p class="small text-muted mb-2"><%= vid.summary.slice(0, 100) %>...</p>
                        </div>
                        <form method="POST" action="/analyze/select_video" class="mt-2">
                            <input type="hidden" name="video_id" value="<%= vid.id %>">
                            <input type="hidden" name="video_data_json" value='<%= JSON.stringify(vid).replace(/'/g, "&apos;") %>'>
                            <input type="hidden" name="channel_title" value="<%= analyzed_channel.channel_title %>">
                            <button type="submit" class="btn btn-sm <%= (typeof selected_video !== 'undefined' && selected_video && selected_video.id === vid.id) ? 'btn-danger' : 'btn-outline-danger' %> w-100 fw-bold">
                                <i class="bi bi-gear-wide me-1"></i> Select for Shorts / AI Video
                            </button>
                        </form>
                    </div>
                </div>
            </div>
            <% }); %>
        </div>
    </div>
    <% } %>

    <!-- Step 3: Dual Strategy Studio for Selected Video -->
    <% if (typeof selected_video !== 'undefined' && selected_video) { %>
    <div class="yt-card p-4 mb-4" id="strategy-studio" style="border-top: 5px solid #FF0000;">
        <div class="row align-items-center mb-4 pb-3 border-bottom">
            <div class="col-md-2">
                <img src="<%= selected_video.thumbnail_url %>" alt="thumb" class="img-fluid rounded shadow-sm">
            </div>
            <div class="col-md-7">
                <span class="badge bg-danger text-uppercase mb-1">Target Video Selected</span>
                <h4 class="fw-bold mb-1"><%= selected_video.title %></h4>
                <div class="text-muted small">
                    Duration: <%= selected_video.duration %> &bull; Views: <%= selected_video.views %> &bull; Channel: <%= typeof selected_video_channel !== 'undefined' ? selected_video_channel : 'Source Channel' %>
                </div>
            </div>
            <div class="col-md-3 text-end">
                <span class="badge bg-light text-dark border p-2 text-start d-block">
                    <i class="bi bi-arrow-repeat text-primary me-1"></i>
                    Strategy can be toggled anytime in Theme settings!
                </span>
            </div>
        </div>

        <h4 class="fw-bold mb-3"><i class="bi bi-diagram-3-fill text-danger me-2"></i>Choose Generation Strategy for this Theme:</h4>

        <!-- Nav Tabs for Strategy Options -->
        <ul class="nav nav-pills mb-4 nav-justified" id="strategyTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link <%= (!active_strategy || active_strategy === 'short_clips') ? 'active' : '' %> py-3 fw-bold" id="clips-tab" data-bs-toggle="pill" data-bs-target="#clips-content" type="button" role="tab">
                    <i class="bi bi-scissors fs-5 d-block mb-1 text-danger"></i>
                    OPTION A: Generate 3-4 Short Clips (YouTube Shorts)
                    <div class="small fw-normal text-muted">Auto-detect viral moments &bull; 9:16 vertical crop &bull; Hook timecodes</div>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link <%= (active_strategy === 'ai_video') ? 'active' : '' %> py-3 fw-bold" id="ai-tab" data-bs-toggle="pill" data-bs-target="#ai-content" type="button" role="tab">
                    <i class="bi bi-stars fs-5 d-block mb-1 text-primary"></i>
                    OPTION B: Generate Similar AI Video
                    <div class="small fw-normal text-muted">Match lighting context &bull; Replicate voiceover cadence &bull; Original concept</div>
                </button>
            </li>
        </ul>

        <div class="tab-content" id="strategyTabContent">
            
            <!-- OPTION A: 3-4 Short Clips (Targeting Most-Viewed Seconds with Exact Original Audio & Video) -->
            <div class="tab-pane fade <%= (!active_strategy || active_strategy === 'short_clips') ? 'show active' : '' %>" id="clips-content" role="tabpanel">
                <div class="alert alert-danger py-3 px-3 mb-4 d-flex align-items-center gap-3 border-2 shadow-sm">
                    <i class="bi bi-fire fs-2 text-danger"></i>
                    <div>
                        <h6 class="fw-bold mb-1">Most-Viewed Seconds AI Extractor (Original Audio &amp; Video)</h6>
                        <div class="small text-dark">
                            AI analyzed the retention curve and detected <strong><%= (clips_data || []).length %> viral peak moments</strong> from <em>"<%= selected_video.title %>"</em>. 
                            Each Short clip below isolates the exact highest-retention replay spike with the <strong>same original audio and video stream</strong>.
                        </div>
                    </div>
                </div>

                <form method="POST" action="/analyze/confirm_clips">
                    <input type="hidden" name="video_id" value="<%= selected_video.id %>">
                    <input type="hidden" name="video_title" value="<%= selected_video.title %>">
                    <input type="hidden" name="video_views" value="<%= selected_video.views %>">
                    <input type="hidden" name="channel_title" value="<%= typeof selected_video_channel !== 'undefined' ? selected_video_channel : 'Source Channel' %>">
                    <input type="hidden" name="video_thumbnail" value="<%= selected_video.thumbnail_url %>">
                    
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Assign to YouTube Channel Output:</label>
                            <select name="target_channel_id" class="form-select">
                                <% (available_accounts || []).forEach(function(acc) { %>
                                    <option value="<%= acc.id %>"><%= acc.channel_title || acc.username %> (<%= acc.handle || ('@' + acc.username) %>)</option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Theme Name:</label>
                            <input type="text" name="theme_name" class="form-control" value="Shorts: <%= selected_video.title.slice(0, 45) %>" required>
                        </div>
                    </div>

                    <h5 class="fw-bold mb-3 d-flex align-items-center justify-content-between">
                        <span><i class="bi bi-film me-2 text-danger"></i>Extracted Viral Shorts Clips (Most-Viewed Spikes):</span>
                        <span class="badge bg-light text-dark border"><i class="bi bi-soundwave text-success me-1"></i> Original Audio &amp; Video Synchronized</span>
                    </h5>

                    <div class="row g-4">
                        <% (clips_data || []).forEach(function(clip, idx) { %>
                        <div class="col-lg-6">
                            <div class="card h-100 border-2 <%= clip.selected ? 'border-primary' : 'border-secondary' %> shadow-sm">
                                <div class="card-header bg-light d-flex justify-content-between align-items-center py-2 flex-wrap gap-1">
                                    <span class="badge bg-danger"><i class="bi bi-youtube me-1"></i> Short Clip #<%= idx + 1 %></span>
                                    <span class="badge bg-success"><i class="bi bi-fire me-1"></i> Viral Score: <%= clip.viral_score %>%</span>
                                    <span class="badge bg-dark font-monospace"><i class="bi bi-stopwatch me-1"></i> <%= clip.timestamp %> (<%= clip.duration_seconds %>s)</span>
                                </div>
                                <div class="card-body p-3">
                                    
                                    <!-- Embedded YouTube Player playing the EXACT clip snippet with original audio and video -->
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="small fw-bold text-dark"><i class="bi bi-play-circle-fill text-danger me-1"></i> Original Video &amp; Audio Player:</span>
                                            <span class="badge bg-success-subtle text-success border border-success" style="font-size: 0.72rem;">
                                                Starts at <%= clip.start_seconds || 15 %>s &bull; <%= clip.duration_seconds %>s clip
                                            </span>
                                        </div>
                                        <div class="position-relative rounded-3 overflow-hidden shadow-sm border bg-black" style="aspect-ratio: 16/9;">
                                            <iframe src="https://www.youtube-nocookie.com/embed/<%= clip.video_id || selected_video.id %>?start=<%= clip.start_seconds || 15 %>&end=<%= clip.end_seconds || (clip.start_seconds + clip.duration_seconds) %>&rel=0&enablejsapi=1" 
                                                    title="<%= clip.title %>" 
                                                    frameborder="0" 
                                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                                                    allowfullscreen 
                                                    style="width: 100%; height: 100%; border: 0; display: block;"></iframe>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center mt-1">
                                            <small class="text-muted" style="font-size: 0.75rem;">
                                                <i class="bi bi-info-circle me-1"></i> Plays original video footage &amp; audio track from timestamp <%= clip.timestamp %>.
                                            </small>
                                            <a href="https://www.youtube.com/watch?v=<%= clip.video_id || selected_video.id %>&t=<%= clip.start_seconds || 15 %>s" target="_blank" class="text-primary small fw-semibold text-decoration-none">
                                                <i class="bi bi-box-arrow-up-right me-1"></i> Open on YouTube
                                            </a>
                                        </div>
                                    </div>

                                    <!-- Hook & Retention Spike Info -->
                                    <div class="mb-2">
                                        <span class="badge bg-warning-subtle text-dark border border-warning mb-1">
                                            <i class="bi bi-graph-up-arrow me-1"></i> <%= clip.retention_metric || 'Most Replayed Spike (Top 1.5% Peak Engagement)' %>
                                        </span>
                                        <div class="p-2 bg-light-subtle rounded border small text-secondary">
                                            <strong>Why this segment is most-viewed:</strong> <%= clip.why_most_viewed || clip.hook_reason %>
                                        </div>
                                    </div>

                                    <!-- Spoken Dialogue / Audio Excerpt -->
                                    <% if (clip.transcript_snippet) { %>
                                    <div class="mb-2">
                                        <label class="form-label small fw-bold mb-1 text-dark"><i class="bi bi-quote text-danger"></i> Original Audio / Dialogue in this Clip:</label>
                                        <div class="p-2 bg-light rounded text-dark font-monospace small border" style="font-size: 0.8rem;">
                                            "<%= clip.transcript_snippet %>"
                                        </div>
                                    </div>
                                    <% } %>

                                    <!-- Edit Hook Title & Timestamps -->
                                    <div class="mb-2">
                                        <label class="form-label small fw-bold mb-0">Clip Hook Title:</label>
                                        <input type="text" name="clip_<%= idx %>_title" class="form-control form-control-sm fw-bold" value="<%= clip.title %>" required>
                                    </div>
                                    <div class="row g-2 mb-2">
                                        <div class="col-6">
                                            <label class="form-label small fw-bold mb-0">Timestamp:</label>
                                            <input type="text" name="clip_<%= idx %>_timestamp" class="form-control form-control-sm" value="<%= clip.timestamp %>">
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label small fw-bold mb-0">Duration (sec):</label>
                                            <input type="number" name="clip_<%= idx %>_duration" class="form-control form-control-sm" value="<%= clip.duration_seconds %>">
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <label class="form-label small fw-bold mb-0">Algorithm Caption &amp; Chapters:</label>
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 0.72rem;" onclick="copyClipDesc(this, <%= idx %>)">
                                                <i class="bi bi-clipboard"></i> Copy Caption
                                            </button>
                                        </div>
                                        <textarea id="clip_desc_<%= idx %>" name="clip_<%= idx %>_description" class="form-control form-control-sm" rows="3"><%= clip.description %></textarea>
                                    </div>

                                    <div class="form-check p-2 bg-light rounded border">
                                        <input class="form-check-input ms-0 me-2" type="checkbox" name="clip_<%= idx %>_include" id="clip_<%= idx %>_include" value="true" checked>
                                        <label class="form-check-label small fw-bold text-dark" for="clip_<%= idx %>_include">
                                            Include Short #<%= idx + 1 %> in Approved Publishing Schedule
                                        </label>
                                    </div>

                                </div>
                            </div>
                        </div>
                        <% }); %>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top flex-wrap gap-2">
                        <span class="text-muted small">
                            <i class="bi bi-shield-check text-success me-1"></i> Will create an active Theme in <strong>Short Clips Mode</strong> with exact original audio &amp; video slices.
                        </span>
                        <button type="submit" class="btn btn-yt-red px-4 py-2 fw-bold">
                            <i class="bi bi-check2-circle me-1"></i> Confirm &amp; Schedule 3-4 Shorts
                        </button>
                    </div>
                </form>
            </div>

            <!-- OPTION B: Similar AI Video (Scene-by-Scene, AI Prompts & Voiceover Script) -->
            <div class="tab-pane fade <%= (active_strategy === 'ai_video') ? 'show active' : '' %>" id="ai-content" role="tabpanel">
                <div class="alert alert-primary py-3 px-3 mb-4 d-flex align-items-center gap-3 border-2 shadow-sm">
                    <i class="bi bi-stars fs-2 text-primary"></i>
                    <div class="flex-grow-1">
                        <h6 class="fw-bold mb-1">AI Video Concept Synthesizer &amp; Storyboard Studio</h6>
                        <div class="small text-dark">
                            Deconstructed <em>"<%= selected_video.title %>"</em> into <strong>complete scene-by-scene animation prompts</strong> and an <strong>original voiceover script</strong> matching its exact lighting, visual cadence, and narrative hook.
                        </div>
                    </div>
                    <form method="POST" action="/analyze/transfer_to_studio" class="m-0">
                        <input type="hidden" name="video_title" value="<%= ai_concept ? ai_concept.title : selected_video.title %>">
                        <input type="hidden" name="video_tags" value="<%= ai_concept ? ai_concept.tags : '#shorts #ai #viral' %>">
                        <input type="hidden" name="scenes_json" value='<%= JSON.stringify((ai_concept && ai_concept.scenes) ? ai_concept.scenes : []).replace(/'/g, "&apos;") %>'>
                        <button type="submit" class="btn btn-sm btn-primary fw-bold text-nowrap shadow-sm">
                            <i class="bi bi-magic me-1"></i> Open in 9:16 Shorts Studio
                        </button>
                    </form>
                </div>

                <!-- Unified Visual & Vocal Profiles -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="p-3 border rounded-3 bg-light h-100">
                            <label class="form-label fw-bold text-dark d-flex align-items-center justify-content-between mb-2">
                                <span><i class="bi bi-lightbulb-fill text-warning me-1"></i> Matched Lighting &amp; Atmosphere:</span>
                                <span class="badge bg-secondary-subtle text-dark border">Visual Direction</span>
                            </label>
                            <textarea id="aiLightingInput" name="ai_lighting_notes" class="form-control mb-2" rows="3"><%= ai_concept ? ai_concept.lighting_style : 'Cinematic Rembrandt lighting with dark teal moody backdrop, 3200K tungsten hair light, subtle anamorphic lens flare.' %></textarea>
                            <small class="text-muted">Unified art direction applied to all scene generation prompts.</small>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 border rounded-3 bg-light h-100">
                            <label class="form-label fw-bold text-dark d-flex align-items-center justify-content-between mb-2">
                                <span><i class="bi bi-mic-fill text-danger me-1"></i> Matched Voiceover Cadence &amp; Tone:</span>
                                <span class="badge bg-secondary-subtle text-dark border">Speech Direction</span>
                            </label>
                            <textarea id="aiVoiceStyleInput" name="ai_voiceover_style" class="form-control mb-2" rows="3"><%= ai_concept ? ai_concept.voiceover_style : 'Fast-paced, hook-heavy narrative voiceover at 165 wpm. Empathetic yet authoritative cadence with dramatic micro-pauses before key takeaways.' %></textarea>
                            <small class="text-muted">Vocal delivery parameters for Gemini TTS speech synthesis.</small>
                        </div>
                    </div>
                </div>

                <!-- Quick Action Bar -->
                <div class="d-flex justify-content-between align-items-center mb-3 p-3 bg-light rounded-3 border flex-wrap gap-2">
                    <div>
                        <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-collection-play-fill text-primary me-2"></i>Complete Scene-by-Scene Breakdown &amp; AI Prompts</h5>
                        <small class="text-muted">Use prompts in Midjourney, Veo 2, or Imagen 3 to generate matching scenes, animations, and voiceovers.</small>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <button type="button" class="btn btn-sm btn-outline-dark fw-semibold" onclick="copyAllAiPrompts()">
                            <i class="bi bi-clipboard-data me-1"></i> Copy All AI Prompts
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-success fw-semibold" onclick="copyFullVoiceoverScript()">
                            <i class="bi bi-mic me-1"></i> Copy Full Script
                        </button>
                        <form method="POST" action="/analyze/transfer_to_studio" class="d-inline mb-0">
                            <input type="hidden" name="video_title" value="<%= ai_concept ? ai_concept.title : selected_video.title %>">
                            <input type="hidden" name="video_tags" value="<%= ai_concept ? ai_concept.tags : '#shorts #ai #viral' %>">
                            <input type="hidden" name="scenes_json" value='<%= JSON.stringify((ai_concept && ai_concept.scenes) ? ai_concept.scenes : []).replace(/'/g, "&apos;") %>'>
                            <button type="submit" class="btn btn-sm btn-yt-red fw-bold shadow-sm">
                                <i class="bi bi-stars me-1"></i> Transfer &amp; Render in 9:16 Shorts Studio
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Scene-by-Scene Cards Container -->
                <div class="row g-4 mb-4" id="scenesContainer">
                    <% if (ai_concept && ai_concept.scenes && ai_concept.scenes.length > 0) { %>
                        <% ai_concept.scenes.forEach(function(sc, sIndex) { %>
                        <div class="col-12">
                            <div class="card border-2 shadow-sm">
                                <div class="card-header bg-white d-flex justify-content-between align-items-center py-2 flex-wrap gap-2 border-bottom">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-primary px-3 py-2 fs-6">Scene <%= sc.scene_number || (sIndex + 1) %></span>
                                        <h6 class="fw-bold mb-0 text-dark"><%= sc.scene_title || ('Scene ' + (sIndex + 1)) %></h6>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-dark font-monospace"><i class="bi bi-clock me-1"></i> <%= sc.timecode || '00:00 - 00:08' %></span>
                                        <span class="badge bg-info-subtle text-info border"><i class="bi bi-palette me-1"></i> <%= sc.visual_type || 'cinematic' %></span>
                                        <span class="badge bg-light text-secondary border"><i class="bi bi-music-note me-1"></i> <%= sc.sound_effect || 'sparkle' %> FX</span>
                                    </div>
                                </div>
                                <div class="card-body p-3">
                                    <div class="row g-3">
                                        
                                        <!-- Column 1: Original Scene Analysis & Animation Direction -->
                                        <div class="col-md-5">
                                            <div class="p-3 bg-light rounded-3 border mb-3 h-100">
                                                <h6 class="fw-bold small text-danger mb-2">
                                                    <i class="bi bi-search me-1"></i> 1. Original Video Scene Analysis:
                                                </h6>
                                                <p class="small text-secondary mb-3" style="line-height: 1.45;">
                                                    <%= sc.original_scene_analysis || 'Analyzes the framing, pacing, and emotional turning point in the original video to guide the recreated scene.' %>
                                                </p>

                                                <h6 class="fw-bold small text-info mb-2">
                                                    <i class="bi bi-camera-reels me-1"></i> 2. Animation &amp; Motion Direction:
                                                </h6>
                                                <p class="small text-dark mb-0 bg-white p-2 rounded border" style="font-size: 0.8rem;">
                                                    <%= sc.animation_direction || 'Smooth slow push-in with floating micro-particles, gentle parallax depth blur.' %>
                                                </p>
                                            </div>
                                        </div>

                                        <!-- Column 2: AI Prompt (Midjourney/Veo 2/Imagen 3) & Voiceover Script -->
                                        <div class="col-md-7">
                                            <!-- AI Prompt Box -->
                                            <div class="p-3 bg-white rounded-3 border border-primary-subtle shadow-xs mb-3">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <span class="fw-bold small text-primary">
                                                        <i class="bi bi-stars me-1"></i> 3. AI Generation Prompt (Veo 2 / Midjourney / Imagen 3):
                                                    </span>
                                                    <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size: 0.72rem;" onclick="copySceneText(this, <%= JSON.stringify(sc.ai_generation_prompt) %>)">
                                                        <i class="bi bi-clipboard me-1"></i> Copy Prompt
                                                    </button>
                                                </div>
                                                <div class="p-2 bg-light rounded border font-monospace text-dark small" style="font-size: 0.82rem; line-height: 1.4;">
                                                    <%= sc.ai_generation_prompt %>
                                                </div>
                                            </div>

                                            <!-- Voiceover Script Box -->
                                            <div class="p-3 bg-white rounded-3 border border-success-subtle shadow-xs">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <span class="fw-bold small text-success">
                                                        <i class="bi bi-mic-fill me-1"></i> 4. Voiceover Script for this Scene:
                                                    </span>
                                                    <button type="button" class="btn btn-sm btn-outline-success py-0 px-2" style="font-size: 0.72rem;" onclick="copySceneText(this, <%= JSON.stringify(sc.voiceover_script) %>)">
                                                        <i class="bi bi-clipboard me-1"></i> Copy Script
                                                    </button>
                                                </div>
                                                <div class="p-2 bg-success-subtle rounded border border-success-subtle text-dark small fst-italic mb-2" style="font-size: 0.85rem;">
                                                    "<%= sc.voiceover_script %>"
                                                </div>
                                                <div class="d-flex justify-content-between align-items-center text-muted small" style="font-size: 0.75rem;">
                                                    <span><i class="bi bi-speedometer2 text-danger me-1"></i> Delivery Cadence: <strong><%= sc.voice_cadence_direction || 'Natural delivery' %></strong></span>
                                                    <span><i class="bi bi-magic text-warning me-1"></i> Sound FX: <strong><%= sc.sound_effect || 'chime' %></strong></span>
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                    <% } else { %>
                        <div class="col-12">
                            <div class="alert alert-warning">
                                No scenes parsed yet. Click "Fetch Top-Viewed &amp; Analyze" above to generate scene-by-scene breakdown.
                            </div>
                        </div>
                    <% } %>
                </div>

                <!-- Continuous Voiceover Script & Metadata Confirmation Form -->
                <form method="POST" action="/analyze/confirm_ai_video" class="yt-card p-4 border-top">
                    <input type="hidden" name="video_id" value="<%= selected_video.id %>">
                    <input type="hidden" name="channel_title" value="<%= typeof selected_video_channel !== 'undefined' ? selected_video_channel : 'Source Channel' %>">
                    <input type="hidden" name="video_thumbnail" value="<%= selected_video.thumbnail_url %>">
                    <input type="hidden" name="ai_lighting_notes" value="<%= ai_concept ? ai_concept.lighting_style : '' %>">
                    <input type="hidden" name="ai_voiceover_style" value="<%= ai_concept ? ai_concept.voiceover_style : '' %>">

                    <h5 class="fw-bold mb-3"><i class="bi bi-pencil-square text-primary me-2"></i>Full Continuous Voiceover Script &amp; Publishing Setup:</h5>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Continuous Voiceover Script (All Scenes Synced):</label>
                        <textarea id="fullAiScriptTextarea" name="ai_voiceover_script" class="form-control font-monospace" rows="4"><%= ai_concept ? ai_concept.script : '' %></textarea>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Assign Output YouTube Channel:</label>
                            <select name="target_channel_id" class="form-select">
                                <% (available_accounts || []).forEach(function(acc) { %>
                                    <option value="<%= acc.id %>"><%= acc.channel_title || acc.username %> (<%= acc.handle || ('@' + acc.username) %>)</option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Theme Name:</label>
                            <input type="text" name="theme_name" class="form-control" value="AI Remake: <%= ai_concept ? ai_concept.title.slice(0, 45) : selected_video.title.slice(0, 45) %>" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">New Video Title:</label>
                            <input type="text" name="video_title" class="form-control" value="<%= ai_concept ? ai_concept.title : 'The Untold Protocol of ' + selected_video.title.slice(0, 30) %>" required>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">YouTube Tags &amp; Hashtags:</label>
                        <input type="text" name="video_tags" class="form-control" value="<%= ai_concept ? ai_concept.tags : '#shorts, #ai, #video, #viral' %>">
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top flex-wrap gap-2">
                        <span class="text-muted small">
                            <i class="bi bi-shield-check text-success me-1"></i> Will create an active Theme in <strong>Similar AI Video Concept Mode</strong> with full scene prompts stored.
                        </span>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-danger fw-bold" onclick="transferCurrentScenesToStudio()">
                                <i class="bi bi-magic me-1"></i> Open &amp; Render in 9:16 Shorts Studio
                            </button>
                            <button type="submit" class="btn btn-yt-red px-4 py-2 fw-bold">
                                <i class="bi bi-check2-circle me-1"></i> Confirm &amp; Schedule AI Video
                            </button>
                        </div>
                    </div>
                </form>
            </div>

        </div>
    </div>
    <% } %>

</div>

<script>
function setInput(val) {
    const input = document.getElementById('channel_or_video_input');
    if (input) {
        input.value = val;
    }
}

function copySceneText(btn, text) {
    if (!text) return;
    navigator.clipboard.writeText(text).then(() => {
        const orig = btn.innerHTML;
        btn.innerHTML = '<i class="bi bi-check2 me-1"></i> Copied!';
        btn.classList.remove('btn-outline-primary', 'btn-outline-success');
        btn.classList.add('btn-success');
        setTimeout(() => {
            btn.innerHTML = orig;
            btn.classList.remove('btn-success');
            btn.classList.add(orig.includes('Prompt') ? 'btn-outline-primary' : 'btn-outline-success');
        }, 2000);
    }).catch(err => {
        console.error('Clipboard copy failed:', err);
    });
}

function copyClipDesc(btn, idx) {
    const textarea = document.getElementById('clip_desc_' + idx);
    if (!textarea) return;
    navigator.clipboard.writeText(textarea.value).then(() => {
        const orig = btn.innerHTML;
        btn.innerHTML = '<i class="bi bi-check2 me-1"></i> Copied!';
        setTimeout(() => {
            btn.innerHTML = orig;
        }, 2000);
    });
}

function copyAllAiPrompts() {
    const scenes = <%- JSON.stringify((ai_concept && ai_concept.scenes) ? ai_concept.scenes : []) %>;
    if (!scenes || scenes.length === 0) {
        alert('No scenes found to copy.');
        return;
    }
    const fullText = scenes.map((sc, i) => 
        `=== SCENE ${sc.scene_number || (i + 1)}: ${sc.scene_title} (${sc.timecode}) ===\n` +
        `ORIGINAL SCENE ANALYSIS:\n${sc.original_scene_analysis}\n\n` +
        `AI GENERATION PROMPT (Veo 2 / Midjourney / Imagen 3):\n${sc.ai_generation_prompt}\n\n` +
        `ANIMATION DIRECTION:\n${sc.animation_direction}\n\n` +
        `VOICEOVER SCRIPT:\n"${sc.voiceover_script}"\n` +
        `DELIVERY: ${sc.voice_cadence_direction || 'Natural'} | SFX: ${sc.sound_effect || 'chime'}\n`
    ).join('\n----------------------------------------\n\n');

    navigator.clipboard.writeText(fullText).then(() => {
        alert('✅ All Scene-by-Scene AI Generation Prompts & Voiceovers copied to clipboard!');
    }).catch(err => {
        alert('Copy failed: ' + err.message);
    });
}

function copyFullVoiceoverScript() {
    const scriptEl = document.getElementById('fullAiScriptTextarea');
    if (scriptEl && scriptEl.value) {
        navigator.clipboard.writeText(scriptEl.value).then(() => {
            alert('✅ Full continuous voiceover script copied to clipboard!');
        });
    }
}

function transferCurrentScenesToStudio() {
    const scenes = <%- JSON.stringify((ai_concept && ai_concept.scenes) ? ai_concept.scenes : []) %>;
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '/analyze/transfer_to_studio';

    const inputTitle = document.createElement('input');
    inputTitle.type = 'hidden';
    inputTitle.name = 'video_title';
    inputTitle.value = "<%= ai_concept ? ai_concept.title.replace(/"/g, '&quot;') : (selected_video ? selected_video.title.replace(/"/g, '&quot;') : 'AI Short') %>";
    form.appendChild(inputTitle);

    const inputTags = document.createElement('input');
    inputTags.type = 'hidden';
    inputTags.name = 'video_tags';
    inputTags.value = "<%= ai_concept ? ai_concept.tags : '#shorts #ai #viral' %>";
    form.appendChild(inputTags);

    const inputScenes = document.createElement('input');
    inputScenes.type = 'hidden';
    inputScenes.name = 'scenes_json';
    inputScenes.value = JSON.stringify(scenes);
    form.appendChild(inputScenes);

    document.body.appendChild(form);
    form.submit();
}
</script>

<%- include('partials/footer') %>
