<%- include('partials/header') %>

<div class="mt-2 mb-5">
    <!-- Page Header & Theme Selector -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 bg-danger-subtle border border-danger rounded-pill text-danger fw-bold small mb-2">
                <i class="bi bi-fire"></i> YouTube Recommendation Algorithm &bull; Viral Outlier Intelligence
            </div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-graph-up-arrow text-danger me-2"></i>Trending &amp; High-Engagement Outliers
            </h2>
            <p class="text-muted mb-0">
                Scans all YouTube channels provided in this theme, pinpoints breakthrough viral outliers, and lets you extract 3-4 Shorts or generate similar AI videos with 1 click.
            </p>
        </div>

        <!-- Theme Switcher Selector -->
        <div class="d-flex align-items-center gap-2 bg-white p-2 rounded-3 border shadow-sm">
            <span class="small fw-bold text-secondary text-nowrap"><i class="bi bi-collection-play text-danger me-1"></i> Theme:</span>
            <select class="form-select form-select-sm fw-bold border-0 bg-light" id="themeSelectDropdown" onchange="window.location.href='/trending?theme_id=' + this.value;">
                <% (themes || []).forEach(function(t) { %>
                    <option value="<%= t.id %>" <%= (selected_theme && selected_theme.id == t.id) ? 'selected' : '' %>>
                        <%= t.theme_name %> (<%= t.strategy === 'ai_video' ? 'AI Video' : 'Shorts Clips' %>)
                    </option>
                <% }); %>
            </select>
        </div>
    </div>

    <% if (selected_theme) { %>
    <!-- Theme Context & Monitored Channel Management Bar -->
    <div class="yt-card p-4 mb-4 border-start border-start-5 <%= selected_theme.strategy === 'ai_video' ? 'border-primary' : 'border-danger' %>">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <% if (selected_theme.strategy === 'ai_video') { %>
                        <span class="badge-ai"><i class="bi bi-stars"></i> Similar AI Video Mode</span>
                    <% } else { %>
                        <span class="badge-shorts"><i class="bi bi-scissors"></i> Shorts Clips Mode (3-4 Extracts)</span>
                    <% } %>
                    <h4 class="fw-bold text-dark mb-0"><%= selected_theme.theme_name %></h4>
                </div>
                <div class="small text-muted">
                    <i class="bi bi-arrow-right-circle text-success me-1"></i> Output Target Channel: 
                    <strong><%= selected_theme.target_account ? (selected_theme.target_account.channel_title || selected_theme.target_account.username) : '@default_channel' %></strong>
                    &bull; Scheduled Rate: <strong><%= selected_theme.schedule ? selected_theme.schedule.posts_per_day : 2 %> uploads/day</strong>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <form method="POST" action="/themes/<%= selected_theme.id %>/switch_strategy" class="d-inline">
                    <input type="hidden" name="new_strategy" value="<%= selected_theme.strategy === 'ai_video' ? 'short_clips' : 'ai_video' %>">
                    <button type="submit" class="btn btn-sm <%= selected_theme.strategy === 'ai_video' ? 'btn-outline-danger' : 'btn-outline-primary' %> fw-bold" title="Switch strategy anytime">
                        <i class="bi bi-arrow-left-right me-1"></i> Switch to <%= selected_theme.strategy === 'ai_video' ? 'Short Clips' : 'AI Video' %>
                    </button>
                </form>
                <a href="/themes/<%= selected_theme.id %>/details" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-gear me-1"></i> Configure Theme
                </a>
            </div>
        </div>

        <!-- Tracked Source Channels Section -->
        <div class="p-3 bg-light rounded-3 border">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                <div class="fw-bold small text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-youtube text-danger"></i> Monitored Channel Links in This Theme (<%= source_channels.length %>):
                </div>
                <button class="btn btn-sm btn-outline-danger py-1 px-3 fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#addChannelCollapse">
                    <i class="bi bi-plus-circle me-1"></i> Add Another Channel Link
                </button>
            </div>

            <!-- Monitored Channels Badges -->
            <div class="d-flex flex-wrap gap-2 mb-2">
                <% if (source_channels && source_channels.length > 0) { %>
                    <% source_channels.forEach(function(ch) { %>
                        <div class="badge bg-white text-dark border p-2 d-flex align-items-center gap-2 shadow-xs">
                            <i class="bi bi-play-circle-fill text-danger"></i>
                            <span class="fw-bold"><%= ch %></span>
                            <form method="POST" action="/themes/<%= selected_theme.id %>/sources/remove_link" class="d-inline m-0 p-0">
                                <input type="hidden" name="channel_to_remove" value="<%= ch %>">
                                <button type="submit" class="btn-close btn-close-sm" style="font-size: 0.65rem;" title="Remove channel from theme" onclick="return confirm('Remove <%= ch %> from this theme?');"></button>
                            </form>
                        </div>
                    <% }); %>
                <% } else { %>
                    <span class="text-muted small">No custom channels added yet. Defaulting to top viral channels in this niche.</span>
                <% } %>
            </div>

            <!-- Add Channel Collapse Form -->
            <div class="collapse mt-3" id="addChannelCollapse">
                <form method="POST" action="/themes/<%= selected_theme.id %>/sources/add_link" class="p-3 bg-white rounded border">
                    <label class="form-label fw-bold small text-dark">Add YouTube Channel URL or Handle:</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-danger"><i class="bi bi-youtube"></i></span>
                        <input type="text" name="channel_input" class="form-control" placeholder="e.g. @veritasium, https://youtube.com/@cocomelon, @mrbeastshorts" required>
                        <button type="submit" class="btn btn-yt-red fw-bold px-4">
                            <i class="bi bi-plus-lg me-1"></i> Add &amp; Scan Outliers
                        </button>
                    </div>
                    <small class="text-muted d-block mt-1">Accepts channel handles (@name), custom URLs, or channel links. We'll automatically pull top trending videos.</small>
                </form>
            </div>
        </div>
    </div>

    <!-- Algorithmic Insights Overview Banner -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="yt-card p-3 bg-white h-100">
                <div class="d-flex align-items-center gap-2 text-danger small fw-bold mb-1">
                    <i class="bi bi-fire fs-5"></i> Peak Outlier Multiplier
                </div>
                <div class="fs-4 fw-bold text-dark"><%= analytics_summary.max_outlier %>x</div>
                <small class="text-muted">Outperforming normal channel views</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="yt-card p-3 bg-white h-100">
                <div class="d-flex align-items-center gap-2 text-primary small fw-bold mb-1">
                    <i class="bi bi-heart-pulse-fill fs-5"></i> Top Engagement Ratio
                </div>
                <div class="fs-4 fw-bold text-dark"><%= analytics_summary.max_engagement %></div>
                <small class="text-muted">Like &amp; comment velocity</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="yt-card p-3 bg-white h-100">
                <div class="d-flex align-items-center gap-2 text-success small fw-bold mb-1">
                    <i class="bi bi-stopwatch-fill fs-5"></i> Optimal Shorts Duration
                </div>
                <div class="fs-4 fw-bold text-dark"><%= analytics_summary.optimal_duration %></div>
                <small class="text-muted">Highest completion &amp; replay loops</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="yt-card p-3 bg-white h-100">
                <div class="d-flex align-items-center gap-2 text-warning small fw-bold mb-1">
                    <i class="bi bi-tags-fill fs-5"></i> Viral Keyword Triggers
                </div>
                <div class="small fw-semibold text-dark text-truncate"><%= analytics_summary.top_keywords %></div>
                <small class="text-muted">High-intent YouTube search queries</small>
            </div>
        </div>
    </div>

    <!-- Filter & Section Title -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <h5 class="fw-bold text-dark mb-0">
            <i class="bi bi-trophy-fill text-warning me-2"></i>Trending Videos Ranked by Viral Outlier Factor (<%= trending_videos.length %>)
        </h5>
        <div class="small text-muted">
            <i class="bi bi-info-circle me-1"></i> Filtered from <strong><%= source_channels.length %> monitored channels</strong> in this theme
        </div>
    </div>

    <!-- Trending Videos Grid -->
    <div class="row g-4">
        <% if (trending_videos && trending_videos.length > 0) { %>
            <% trending_videos.forEach(function(video, index) { %>
            <div class="col-lg-6">
                <div class="yt-card h-100 p-3 d-flex flex-column justify-content-between border position-relative">
                    
                    <div>
                        <!-- Top Metadata Row: Channel & Outlier Badges -->
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-dark text-white rounded-pill px-2 py-1 small">#<%= index + 1 %></span>
                                <span class="fw-bold text-dark small"><i class="bi bi-youtube text-danger me-1"></i><%= video.channel_title %></span>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <span class="badge bg-danger text-white fw-bold px-2 py-1">
                                    <i class="bi bi-fire me-1"></i><%= video.outlier_multiplier %> Outlier
                                </span>
                                <span class="badge bg-primary-subtle text-primary border border-primary fw-bold px-2 py-1">
                                    <i class="bi bi-lightning-charge-fill me-1"></i><%= video.engagement_rate %>
                                </span>
                            </div>
                        </div>

                        <!-- Video Media & Details Row -->
                        <div class="row g-3 mb-3">
                            <div class="col-sm-5">
                                <div class="position-relative rounded-3 overflow-hidden bg-black shadow-sm" style="aspect-ratio: 16/9;">
                                    <img src="<%= video.thumbnail_url %>" alt="<%= video.title %>" style="width: 100%; height: 100%; object-fit: cover;">
                                    <span class="badge bg-dark bg-opacity-75 text-white position-absolute bottom-0 end-0 m-1 small font-monospace">
                                        <%= video.duration %>
                                    </span>
                                </div>
                                <div class="d-flex justify-content-around mt-2 text-center text-muted small bg-light p-1 rounded border">
                                    <div><strong class="text-dark"><%= video.views %></strong> views</div>
                                    <div><strong class="text-dark"><%= video.likes %></strong> likes</div>
                                </div>
                            </div>
                            <div class="col-sm-7">
                                <h6 class="fw-bold text-dark mb-1" style="line-height: 1.35;">
                                    <a href="https://www.youtube.com/watch?v=<%= video.id %>" target="_blank" class="text-dark text-decoration-none hover-danger">
                                        <%= video.title %> <i class="bi bi-box-arrow-up-right text-muted small ms-1"></i>
                                    </a>
                                </h6>
                                <p class="small text-secondary mb-2" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    <%= video.summary %>
                                </p>
                                
                                <div class="badge bg-secondary-subtle text-dark border small p-1 px-2 mb-2">
                                    <i class="bi bi-speedometer2 text-danger me-1"></i> Momentum: <strong><%= video.momentum %></strong>
                                </div>
                            </div>
                        </div>

                        <!-- Algorithmic Hook & Reach Analysis -->
                        <div class="p-2 mb-3 rounded-2 bg-light border">
                            <div class="d-flex align-items-center gap-1 small text-dark fw-bold mb-1">
                                <i class="bi bi-cpu-fill text-danger"></i> YouTube Algorithm Breakout Trigger:
                            </div>
                            <div class="small text-muted" style="line-height: 1.4;">
                                <strong>Hook:</strong> <%= video.retention_hook %><br>
                                <strong>Tags:</strong> <span class="text-primary font-monospace small"><%= video.viral_tags %></span>
                            </div>
                        </div>
                    </div>

                    <!-- 1-Click Action Buttons for User Channel -->
                    <div class="pt-2 border-top">
                        <div class="d-flex flex-wrap gap-2">
                            <!-- Action 1: Extract 3-4 Shorts -->
                            <a href="/analyze?input=<%= encodeURIComponent('https://www.youtube.com/watch?v=' + video.id) %>&strategy=short_clips&theme_id=<%= selected_theme.id %>" 
                               class="btn btn-sm btn-yt-red fw-bold flex-grow-1">
                                <i class="bi bi-scissors me-1"></i> Extract 3-4 Viral Shorts
                            </a>

                            <!-- Action 2: Generate Similar AI Video -->
                            <a href="/analyze?input=<%= encodeURIComponent('https://www.youtube.com/watch?v=' + video.id) %>&strategy=ai_video&theme_id=<%= selected_theme.id %>" 
                               class="btn btn-sm btn-outline-primary fw-bold flex-grow-1">
                                <i class="bi bi-stars me-1"></i> Generate Similar AI Video
                            </a>
                        </div>
                    </div>

                </div>
            </div>
            <% }); %>
        <% } else { %>
            <div class="col-12">
                <div class="yt-card p-5 text-center">
                    <i class="bi bi-graph-down text-secondary fs-1 mb-3 d-block"></i>
                    <h5 class="fw-bold">No Videos Found for this Theme's Monitored Channels</h5>
                    <p class="text-muted mb-4">Add channel handles or links using the form above to trigger the trending outlier scan.</p>
                </div>
            </div>
        <% } %>
    </div>
    <% } else { %>
    <div class="yt-card p-5 text-center">
        <i class="bi bi-collection-play text-danger fs-1 mb-3 d-block"></i>
        <h4 class="fw-bold">No Active Themes Available</h4>
        <p class="text-muted mb-4">Create or approve a theme first to scan its monitored channels for trending videos.</p>
        <a href="/analyze" class="btn btn-yt-red fw-bold px-4 py-2">Create Theme in Studio</a>
    </div>
    <% } %>
</div>

<%- include('partials/footer') %>
