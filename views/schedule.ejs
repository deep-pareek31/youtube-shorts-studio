<%- include('partials/header') %>

<div class="mt-2 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-clock-history text-danger me-2"></i>YouTube Upload Scheduler &amp; Automated Pipeline</h2>
            <p class="text-muted mb-0">Manage automatic daily publishing quotas, view today's scheduled Shorts slots, and trigger batch processing.</p>
        </div>
        <a href="/all_posts" class="btn btn-outline-secondary btn-sm"><i class="bi bi-list-check me-1"></i> View All Content</a>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-5">
            <div class="yt-card p-4">
                <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-sliders text-danger me-2"></i>Global Automation Settings</h5>
                <form method="POST" action="/schedule">
                    <div class="mb-3">
                        <label for="daily_quota" class="form-label fw-bold">Global Daily Upload Quota (Shorts/Videos):</label>
                        <input type="number" class="form-control" id="daily_quota" name="daily_quota" value="2" min="1" max="10">
                        <small class="text-muted">Maximum number of automated uploads across all active themes per day.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Automated Publishing Engine:</label>
                        <div class="p-3 bg-light rounded border">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="autoPublishSwitch" checked>
                                <label class="form-check-label fw-bold text-dark" for="autoPublishSwitch">Auto-Publish Approved Content</label>
                            </div>
                            <small class="text-muted d-block">When enabled, approved Shorts and AI videos are sent to YouTube Data API v3 at their assigned time slots.</small>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-yt-red w-100 fw-bold py-2">
                        <i class="bi bi-play-circle-fill me-1"></i> Save &amp; Run Automated Dispatch
                    </button>
                </form>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="yt-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-calendar2-day text-danger me-2"></i>Today's Scheduled Dispatch Queue</h5>
                    <span class="badge bg-danger"><%= scheduled_posts ? scheduled_posts.length : 0 %> Items Ready</span>
                </div>

                <% if (scheduled_posts && scheduled_posts.length > 0) { %>
                <div class="list-group list-group-flush">
                    <% scheduled_posts.forEach(function(post) { %>
                    <div class="list-group-item p-3 d-flex justify-content-between align-items-center border rounded-3 mb-2 bg-light">
                        <div class="d-flex align-items-center gap-3">
                            <div style="width: 44px; height: 58px; background: #000; border-radius: 4px; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                                <% if (post.image_filename) { %>
                                    <img src="/uploads/media_files/<%= post.image_filename %>" style="width: 100%; height: 100%; object-fit: cover;">
                                <% } else { %>
                                    <i class="bi bi-play text-white fs-4"></i>
                                <% } %>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0 text-dark"><%= post.theme %></h6>
                                <div class="text-muted small">
                                    <% if (post.post_type === 'ai_video') { %>
                                        <span class="badge-ai"><i class="bi bi-stars"></i> AI Video</span>
                                    <% } else { %>
                                        <span class="badge-shorts"><i class="bi bi-scissors"></i> <%= post.clip_timestamp || 'Shorts' %></span>
                                    <% } %>
                                    &bull; Upload Time: <span class="fw-bold text-dark"><%= post.scheduled_time_formatted || '15:30' %></span>
                                </div>
                            </div>
                        </div>
                        <div>
                            <span class="badge <%= post.status === 'scheduled' ? 'bg-primary' : (post.status === 'posted' ? 'bg-success' : 'bg-warning text-dark') %> me-2">
                                <%= post.status %>
                            </span>
                            <a href="/all_posts" class="btn btn-sm btn-outline-secondary">Review</a>
                        </div>
                    </div>
                    <% }); %>
                </div>
                <% } else { %>
                <div class="text-center text-muted py-5">
                    <i class="bi bi-clock fs-1 text-secondary mb-2 d-block"></i>
                    No uploads scheduled for today. Create or approve content from the <a href="/all_posts">Review Queue</a>.
                </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
