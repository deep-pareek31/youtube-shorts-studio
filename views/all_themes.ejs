<%- include('partials/header') %>

<div class="mt-2 mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-collection-play text-danger me-2"></i>Approved Themes &amp; Strategy Pipelines</h2>
            <p class="text-muted mb-0">Manage your automated content channels. <strong>You can switch any theme's strategy between Shorts clips and AI Video remakes at any time.</strong></p>
        </div>
        <a href="/analyze" class="btn btn-yt-red"><i class="bi bi-plus-circle me-1"></i> New Channel Analysis</a>
    </div>

    <% if (themes && themes.length > 0) { %>
    <div class="row g-4">
        <% themes.forEach(function(theme) { %>
        <div class="col-lg-6">
            <div class="yt-card h-100 p-4 border-start <%= theme.strategy === 'ai_video' ? 'border-primary' : 'border-danger' %> border-start-5">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <% if (theme.strategy === 'ai_video') { %>
                            <span class="badge-ai mb-1"><i class="bi bi-stars"></i> Similar AI Video Mode</span>
                        <% } else { %>
                            <span class="badge-shorts mb-1"><i class="bi bi-scissors"></i> Shorts Clips Mode (3-4 Extracts)</span>
                        <% } %>
                        <h5 class="fw-bold text-dark mb-0"><%= theme.theme_name %></h5>
                    </div>
                    <div>
                        <% if (theme.is_active) { %>
                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Active</span>
                        <% } else { %>
                            <span class="badge bg-secondary"><i class="bi bi-pause-circle me-1"></i>Paused</span>
                        <% } %>
                    </div>
                </div>

                <div class="text-muted small mb-3">
                    <i class="bi bi-person-video me-1"></i> Target Channel: <strong><%= theme.youtube_channel ? (theme.youtube_channel.channel_title || theme.youtube_channel.username) : '@default_channel' %></strong>
                    <% if (theme.source_channel_or_video) { %>
                        &bull; Source: <span class="text-danger fw-semibold"><%= theme.source_channel_or_video %></span>
                    <% } %>
                </div>

                <!-- Media / Blueprint Snapshot -->
                <div class="row g-2 mb-3 align-items-center bg-light p-2 rounded border">
                    <div class="col-auto">
                        <div style="width: 75px; height: 75px; border-radius: 6px; overflow: hidden; background: #000;">
                            <% if (theme.base_media_filename) { %>
                                <img src="/uploads/media_files/<%= theme.base_media_filename %>" alt="thumb" style="width: 100%; height: 100%; object-fit: cover;">
                            <% } else { %>
                                <div class="h-100 d-flex align-items-center justify-content-center text-white"><i class="bi bi-camera-reels fs-4"></i></div>
                            <% } %>
                        </div>
                    </div>
                    <div class="col">
                        <% if (theme.strategy === 'ai_video') { %>
                            <div class="small text-dark mb-1">
                                <strong><i class="bi bi-lightbulb-fill text-warning"></i> Lighting:</strong> <%= theme.ai_lighting_profile ? theme.ai_lighting_profile.slice(0, 65) + '...' : 'Cinematic rim lighting with dark backdrop' %>
                            </div>
                            <div class="small text-muted">
                                <strong><i class="bi bi-mic-fill text-danger"></i> Voiceover:</strong> <%= theme.ai_voiceover_style ? theme.ai_voiceover_style.slice(0, 65) + '...' : 'Fast-paced storytelling at 165 wpm' %>
                            </div>
                        <% } else { %>
                            <div class="small text-dark mb-1">
                                <strong><i class="bi bi-scissors text-danger"></i> Extraction:</strong> 3-4 High-engagement viral segments from full long-form video.
                            </div>
                            <div class="small text-muted">
                                <strong><i class="bi bi-aspect-ratio"></i> Aspect:</strong> 9:16 Vertical Crop with auto-subtitles.
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Strategy Switcher Section (User can change functionality at anytime!) -->
                <div class="p-3 mb-3 rounded-3" style="background-color: #F3F4F6; border: 1px dashed #CBD5E1;">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="small fw-bold text-dark d-block">
                                <i class="bi bi-arrow-repeat text-primary me-1"></i> Current Functionality:
                            </span>
                            <span class="small text-muted">
                                <%= theme.strategy === 'ai_video' ? 'Generates original AI Video scripts with matched lighting & VO' : 'Extracts 3-4 vertical YouTube Shorts clips' %>
                            </span>
                        </div>
                        <form method="POST" action="/themes/<%= theme.id %>/switch_strategy">
                            <input type="hidden" name="new_strategy" value="<%= theme.strategy === 'ai_video' ? 'short_clips' : 'ai_video' %>">
                            <button type="submit" class="btn btn-sm <%= theme.strategy === 'ai_video' ? 'btn-outline-danger' : 'btn-outline-primary' %> fw-bold" title="Switch strategy pipeline">
                                <i class="bi bi-arrow-left-right me-1"></i> Switch to <%= theme.strategy === 'ai_video' ? 'Short Clips' : 'AI Video' %>
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Actions Bar -->
                <div class="d-flex flex-wrap align-items-center gap-2 pt-2 border-top">
                    <a href="/themes/<%= theme.id %>/trending" class="btn btn-sm btn-yt-red fw-bold">
                        <i class="bi bi-fire me-1"></i> Trending Outliers (<%= (theme.source_accounts || []).length %> Channels)
                    </a>
                    <a href="/themes/<%= theme.id %>/configure_schedule" class="btn btn-sm btn-outline-success">
                        <i class="bi bi-calendar3 me-1"></i> Daily Schedule (<%= theme.schedule ? theme.schedule.posts_per_day : 2 %>/day)
                    </a>
                    <a href="/themes/<%= theme.id %>/details" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-sliders me-1"></i> Edit Channels &amp; Prompts
                    </a>
                    
                    <form method="POST" action="/themes/<%= theme.id %>/toggle_active" style="display: inline-block;">
                        <% if (theme.is_active) { %>
                            <button type="submit" class="btn btn-sm btn-warning" title="Pause automated posting">
                                <i class="bi bi-pause-fill"></i> Pause
                            </button>
                        <% } else { %>
                            <button type="submit" class="btn btn-sm btn-success" title="Resume automated posting">
                                <i class="bi bi-play-fill"></i> Start
                            </button>
                        <% } %>
                    </form>

                    <form method="POST" action="/themes/<%= theme.id %>/delete" style="display: inline-block;" onsubmit="return confirm('Are you sure you want to delete this theme?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Theme">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
        <% }); %>
    </div>
    <% } else { %>
    <div class="yt-card p-5 text-center">
        <i class="bi bi-collection-play text-danger fs-1 mb-3 d-block"></i>
        <h4 class="fw-bold">No Themes Created Yet</h4>
        <p class="text-muted mb-4" style="max-width: 500px; margin: 0 auto;">
            Analyze any YouTube channel or video link to extract 3-4 Short clips or generate similar AI videos, and save them as ongoing automated themes.
        </p>
        <a href="/analyze" class="btn btn-yt-red px-4 py-2 fw-bold">
            <i class="bi bi-lightning-charge-fill me-1"></i> Start Channel Analysis
        </a>
    </div>
    <% } %>
</div>

<%- include('partials/footer') %>
