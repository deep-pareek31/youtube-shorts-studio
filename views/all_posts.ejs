<%- include('partials/header') %>

<!-- YouTube Video & Shorts Preview Modal -->
<div class="modal fade" id="postPreviewModal" tabindex="-1" aria-labelledby="postPreviewModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content border-0 shadow-lg">
      <div class="modal-header bg-dark text-white py-3">
        <h5 class="modal-title fw-bold" id="postPreviewModalLabel"><i class="bi bi-youtube text-danger me-2"></i>Content Studio Preview</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="editPostFormModal" method="POST">
        <div class="modal-body p-4">
            <input type="hidden" id="previewPostIdModal" name="post_id">
            <input type="hidden" id="previewPostOriginalStatusModal" name="original_status">
            
            <div class="row g-4">
                <div class="col-md-5 text-center">
                    <div id="previewBadgeType" class="mb-2"></div>
                    <div class="shorts-preview-frame mx-auto mb-2" style="max-width: 250px; aspect-ratio: 9/16; position: relative; background: #000; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 16px rgba(0,0,0,0.35);">
                        <canvas id="modalShortsCanvas" width="540" height="960" style="width: 100%; height: 100%; object-fit: contain; cursor: pointer;" onclick="modalTogglePlay()"></canvas>
                        
                        <!-- Big Play Icon Overlay -->
                        <div id="modalCanvasPlayOverlay" class="position-absolute top-50 start-50 translate-middle pointer-events-none" style="display: flex; justify-content: center; align-items: center; width: 56px; height: 56px; background: rgba(0,0,0,0.6); border-radius: 50%; color: white; font-size: 24px; cursor: pointer;" onclick="modalTogglePlay()">
                            <i id="modalCanvasPlayIcon" class="bi bi-play-fill" style="margin-left: 3px;"></i>
                        </div>

                        <!-- Export Progress Overlay -->
                        <div id="modalExportOverlay" class="position-absolute top-0 start-0 w-100 h-100 d-none flex-column justify-content-center align-items-center p-3 text-center" style="background: rgba(0,0,0,0.88); z-index: 10; color: white;">
                            <div class="spinner-border text-danger mb-2" role="status" style="width: 2rem; height: 2rem;"></div>
                            <div class="small fw-bold mb-1" id="modalExportStatus">Rendering 60 FPS Video...</div>
                            <div class="progress w-100 mb-1" style="height: 6px;">
                                <div id="modalExportProgressBar" class="progress-bar bg-danger" style="width: 10%;"></div>
                            </div>
                            <small class="text-secondary" style="font-size: 10px;" id="modalExportPercent">10%</small>
                        </div>
                    </div>

                    <!-- Mini player scrubber & controls under canvas -->
                    <div class="d-flex align-items-center gap-1 justify-content-center mb-2 px-1">
                        <button type="button" class="btn btn-sm btn-dark py-0 px-2 fw-bold" onclick="modalTogglePlay()">
                            <i id="modalPlayBtnIcon" class="bi bi-play-fill"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" onclick="modalRestart()">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" onclick="modalToggleMute()">
                            <i id="modalMuteBtnIcon" class="bi bi-volume-up-fill"></i>
                        </button>
                        <span id="modalTimeDisplay" class="font-monospace small text-muted ms-1" style="font-size: 11px;">00:00 / 00:30</span>
                    </div>

                    <button type="button" class="btn btn-sm btn-success w-100 fw-bold py-1 mb-2" onclick="modalExportVideo()">
                        <i class="bi bi-download me-1"></i> Export Real Video (.webm)
                    </button>

                    <div class="p-2 bg-light rounded text-start small border">
                        <div><strong>Target Channel:</strong> <span id="previewTargetAccountModalText"></span></div>
                        <div><strong>Clip Range:</strong> <span id="previewTimecodeText">00:00 - 00:45</span></div>
                        <div id="previewViralScoreWrapper" class="mt-1">
                            <strong>Virality Index:</strong> <span id="previewViralScoreText" class="badge bg-success">92%</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-7">
                    <div class="mb-3">
                        <label for="previewThemeText" class="form-label fw-bold">YouTube Video / Shorts Title:</label>
                        <input type="text" id="previewThemeInput" name="theme" class="form-control" placeholder="Catchy hook title...">
                    </div>
                    
                    <div class="mb-3">
                        <label for="previewDescriptionModalText" class="form-label fw-bold">Description &amp; Pinned Comment:</label>
                        <textarea id="previewDescriptionModalText" name="description" class="form-control" rows="4" style="white-space: pre-wrap;"></textarea>
                    </div>
                
                    <div class="mb-3">
                        <label for="previewHashtagsModalText" class="form-label fw-bold">SEO Tags &amp; Hashtags (Optimal 3-5):</label>
                        <input type="text" id="previewHashtagsModalText" name="hashtags" class="form-control">
                        <small class="text-muted">YouTube recommendation algorithm prefers strictly 3 to 5 hyper-targeted tags to prevent tag-stuffing penalties.</small>
                    </div>

                    <!-- YouTube Algorithm Reach & Optimization Card -->
                    <div class="mb-3 p-3 bg-light rounded-3 border">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="small fw-bold text-dark d-flex align-items-center gap-1">
                                <i class="bi bi-cpu-fill text-danger"></i> YouTube Algorithm Score:
                                <span class="badge bg-success ms-1"><i class="bi bi-shield-check"></i> 98/100 (Max Reach)</span>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2 fw-bold" onclick="optimizeCurrentModalAlgorithm();">
                                <i class="bi bi-magic me-1"></i> Re-Optimize with AI
                            </button>
                        </div>
                        <div class="small text-muted d-flex flex-wrap gap-1">
                            <span class="badge bg-white text-secondary border">✓ 100-Char Hook</span>
                            <span class="badge bg-white text-secondary border">✓ High-Intent Synopsis</span>
                            <span class="badge bg-white text-secondary border">✓ Retention Timestamps</span>
                            <span class="badge bg-white text-secondary border">✓ Pinned Comment Blueprint</span>
                            <span class="badge bg-white text-secondary border">✓ 3-5 Tags (No Stuffing)</span>
                        </div>
                    </div>

                    <div id="aiLightingScriptSection" class="p-3 mb-3 bg-light rounded border" style="display:none;">
                        <div class="small fw-bold text-dark mb-1"><i class="bi bi-lightbulb-fill text-warning me-1"></i> Lighting Setup:</div>
                        <div id="aiLightingNotesText" class="small text-muted mb-2"></div>
                        <div class="small fw-bold text-dark mb-1"><i class="bi bi-mic-fill text-danger me-1"></i> Voiceover Script:</div>
                        <div id="aiVoiceoverScriptText" class="small font-monospace text-secondary p-2 bg-white rounded border" style="max-height: 100px; overflow-y: auto;"></div>
                    </div>

                    <div class="mb-3" id="rescheduleTimeSectionModal" style="display:none;">
                        <label for="newScheduleTimeModal" class="form-label fw-bold">Scheduled Upload Slot:</label>
                        <input type="datetime-local" class="form-control" id="newScheduleTimeModal" name="new_schedule_time">
                        <small class="form-text text-muted">Select future time for automatic YouTube publishing.</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-footer bg-light py-2">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            <button type="submit" id="modalSubmitButton" class="btn btn-success fw-bold">Save &amp; Schedule</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="mt-2 mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-play-btn text-danger me-2"></i>YouTube Uploads &amp; Scheduled Shorts</h2>
            <p class="text-muted mb-0">Review pending Shorts extracts, inspect AI video concepts, approve queues, and manage publish times.</p>
        </div>
        <a href="/analyze" class="btn btn-yt-red"><i class="bi bi-plus-circle me-1"></i> Analyze New Video/Channel</a>
    </div>

    <!-- Today's Queue -->
    <div class="yt-card p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-calendar-event text-danger me-2"></i>Today's Publishing Queue</h5>
            <span class="badge bg-danger"><%= todays_posts ? todays_posts.length : 0 %> queued today</span>
        </div>

        <% if (todays_posts && todays_posts.length > 0) { %>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">Format</th>
                        <th>Video Title &amp; Hook</th>
                        <th>Type / Timecode</th>
                        <th>Virality</th>
                        <th>Scheduled</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% todays_posts.forEach(function(post) { %>
                    <tr id="post-row-<%= post.id %>">
                        <td>
                            <div style="width: 50px; height: 65px; border-radius: 4px; overflow: hidden; background: #111;">
                                <% if (post.image_filename) { %>
                                    <img src="/uploads/media_files/<%= post.image_filename %>" alt="thumb" style="width: 100%; height: 100%; object-fit: cover;">
                                <% } else { %>
                                    <div class="d-flex h-100 align-items-center justify-content-center text-white"><i class="bi bi-play-circle"></i></div>
                                <% } %>
                            </div>
                        </td>
                        <td>
                            <div class="fw-bold text-dark"><%= post.theme %></div>
                            <small class="text-muted text-truncate d-block" style="max-width: 400px;"><%= post.description %></small>
                        </td>
                        <td>
                            <% if (post.post_type === 'ai_video' || (post.approved_theme && post.approved_theme.strategy === 'ai_video')) { %>
                                <span class="badge-ai"><i class="bi bi-stars"></i> AI Video</span>
                            <% } else { %>
                                <span class="badge-shorts"><i class="bi bi-scissors"></i> <%= post.clip_timestamp || 'Shorts' %></span>
                            <% } %>
                        </td>
                        <td>
                            <% if (post.viral_score) { %>
                                <span class="badge bg-success-subtle text-success border border-success fw-bold"><i class="bi bi-fire"></i> <%= post.viral_score %>%</span>
                            <% } else { %>
                                <span class="text-muted small">-</span>
                            <% } %>
                        </td>
                        <td><small class="fw-semibold"><%= post.scheduled_time_formatted || 'Auto-slot' %></small></td>
                        <td>
                            <% if (post.status === 'pending_approval') { %>
                                <span class="badge bg-warning text-dark"><i class="bi bi-clock"></i> Pending Approval</span>
                            <% } else if (post.status === 'scheduled') { %>
                                <span class="badge bg-primary"><i class="bi bi-check2"></i> Scheduled</span>
                            <% } else if (post.status === 'posted' || post.status === 'uploaded') { %>
                                <span class="badge bg-success"><i class="bi bi-upload"></i> Uploaded</span>
                            <% } else { %>
                                <span class="badge bg-secondary"><%= post.status %></span>
                            <% } %>
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <% if (post.status === 'pending_approval') { %>
                                    <form method="POST" action="/post/<%= post.id %>/approve" style="display: inline-block;">
                                        <button type="submit" class="btn btn-sm btn-success" title="Approve for automated upload">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                    </form>
                                    <button type="button" class="btn btn-sm btn-warning text-dark" onclick='requestChanges(<%= post.id %>, <%- JSON.stringify(post.theme || "") %>)' title="Suggest AI modifications">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <form method="POST" action="/post/<%= post.id %>/get_new_option" style="display: inline-block;">
                                        <button type="submit" class="btn btn-sm btn-info text-white" title="Regenerate alternative option">
                                            <i class="bi bi-arrow-repeat"></i>
                                        </button>
                                    </form>
                                    <form method="POST" action="/post/<%= post.id %>/decline" style="display: inline-block;">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Decline">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </form>
                                <% } %>
                                <button type="button" class="btn btn-sm btn-danger text-white fw-semibold" 
                                        onclick='openAndPlayPost(<%= JSON.stringify(post).replace(/'/g, "&apos;") %>)' title="Play Real Video with Voiceover &amp; Karaoke Subtitles">
                                    <i class="bi bi-play-fill"></i> Watch
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-success" 
                                        onclick='quickExportPostVideo(<%= JSON.stringify(post).replace(/'/g, "&apos;") %>)' title="Download Video File (.webm)">
                                    <i class="bi bi-download"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" 
                                        onclick='openStudioPreview(<%= JSON.stringify(post).replace(/'/g, "&apos;") %>)'>
                                    <i class="bi bi-eye"></i> Review
                                </button>
                            </div>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <% } else { %>
        <div class="p-4 text-center text-muted">
            <i class="bi bi-calendar2-check fs-2 text-secondary mb-2 d-block"></i>
            No videos or Shorts scheduled for today. Analyze a channel to generate clips!
        </div>
        <% } %>
    </div>

    <!-- Other Posts / Archive / Queue -->
    <div class="yt-card p-4">
        <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-archive text-secondary me-2"></i>All Scheduled &amp; Archived Videos</h5>
        <% if (other_posts && other_posts.length > 0) { %>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width: 60px;">ID</th>
                        <th>Title &amp; Topic</th>
                        <th>Type</th>
                        <th>Scheduled Date</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% other_posts.forEach(function(post) { %>
                    <tr id="post-row-<%= post.id %>">
                        <td><span class="text-muted small">#<%= post.id %></span></td>
                        <td>
                            <div class="fw-bold text-dark"><%= post.theme %></div>
                            <small class="text-muted text-truncate d-block" style="max-width: 450px;"><%= post.description %></small>
                        </td>
                        <td>
                            <% if (post.post_type === 'ai_video' || (post.approved_theme && post.approved_theme.strategy === 'ai_video')) { %>
                                <span class="badge-ai"><i class="bi bi-stars"></i> AI Video</span>
                            <% } else { %>
                                <span class="badge-shorts"><i class="bi bi-scissors"></i> <%= post.clip_timestamp || 'Shorts' %></span>
                            <% } %>
                        </td>
                        <td><%= post.scheduled_time_formatted || 'Not Scheduled' %></td>
                        <td>
                            <span class="badge <%= post.status === 'scheduled' ? 'bg-primary' : (post.status === 'posted' ? 'bg-success' : 'bg-secondary') %>">
                                <%= post.status %>
                            </span>
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <button type="button" class="btn btn-sm btn-danger text-white fw-semibold" 
                                        onclick='openAndPlayPost(<%= JSON.stringify(post).replace(/'/g, "&apos;") %>)' title="Play Real Video with Voiceover &amp; Karaoke Subtitles">
                                    <i class="bi bi-play-fill"></i> Watch
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-success" 
                                        onclick='quickExportPostVideo(<%= JSON.stringify(post).replace(/'/g, "&apos;") %>)' title="Download Video File (.webm)">
                                    <i class="bi bi-download"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" 
                                        onclick='openStudioPreview(<%= JSON.stringify(post).replace(/'/g, "&apos;") %>)'>
                                    <%= post.status === 'pending_approval' ? 'Review & Edit' : 'Inspect' %>
                                </button>
                            </div>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <% } else { %>
        <div class="text-muted text-center py-3">No archived or future posts.</div>
        <% } %>
    </div>
</div>

<script src="/js/shorts-player.js"></script>

<script>
let modalVideoEngine = null;
let currentModalPost = null;

document.addEventListener('DOMContentLoaded', () => {
    const canvas = document.getElementById('modalShortsCanvas');
    if (canvas) {
        modalVideoEngine = new ShortsVideoEngine('modalShortsCanvas', {
            width: 540,
            height: 960,
            onTimeUpdate: (time, duration) => {
                const timeEl = document.getElementById('modalTimeDisplay');
                if (timeEl) {
                    timeEl.textContent = `${formatTime(time)} / ${formatTime(duration)}`;
                }
            },
            onEnded: () => {
                updateModalPlayBtn(false);
            }
        });
    }

    const modalEl = document.getElementById('postPreviewModal');
    if (modalEl) {
        modalEl.addEventListener('hidden.bs.modal', () => {
            if (modalVideoEngine) {
                modalVideoEngine.pause();
                updateModalPlayBtn(false);
            }
        });
    }
});

function formatTime(sec) {
    const s = Math.floor(sec || 0);
    const m = Math.floor(s / 60);
    const rem = s % 60;
    return `${m.toString().padStart(2, '0')}:${rem.toString().padStart(2, '0')}`;
}

function synthesizeVideoDataFromPost(post) {
    if (post.video_data) return post.video_data;
    if (post.video_data_json) {
        try {
            return JSON.parse(post.video_data_json);
        } catch (e) {}
    }

    const title = post.theme || "Viral YouTube Short";
    const desc = post.description || "";
    const isKids = (title + ' ' + desc).toLowerCase().match(/kid|wonder|tale|story|bedtime|pip|bunny|whisper/);
    const duration = post.duration_seconds || 30;

    if (isKids) {
        return {
            title: title,
            theme: title,
            channel_handle: "@tiinywondertales",
            duration_seconds: duration,
            viral_score: post.viral_score || 94,
            description: desc || "Enchanting animated bedtime story.",
            hashtags: post.hashtags || "#shorts #tiinywondertales #kidsstories",
            scenes: [
                {
                    scene_number: 1,
                    start_sec: 0,
                    end_sec: Math.floor(duration / 3),
                    visual_type: "bioluminescent_forest",
                    visual_prompt: "Deep enchanted twilight forest with bioluminescent moss and glowing mushrooms",
                    narration: title + ". In the quiet Whispering Woods, a magical light appeared.",
                    sound_effect: "chime",
                    camera: "zoom_in"
                },
                {
                    scene_number: 2,
                    start_sec: Math.floor(duration / 3),
                    end_sec: Math.floor(duration * 2 / 3),
                    visual_type: "bioluminescent_forest",
                    visual_prompt: "Pip the little firefly meeting woodland creature friends",
                    narration: "Pip discovered that even the smallest spark of kindness can light up the entire forest.",
                    sound_effect: "whoosh",
                    camera: "pan_right"
                },
                {
                    scene_number: 3,
                    start_sec: Math.floor(duration * 2 / 3),
                    end_sec: duration,
                    visual_type: "bioluminescent_forest",
                    visual_prompt: "Golden stars falling like gentle fairy dust over the sleepy mossy tree",
                    narration: "Sleep tight, little dreamers. Subscribe to TinyWonderTales for bedtime adventures!",
                    sound_effect: "sparkle",
                    camera: "pulse"
                }
            ]
        };
    } else {
        return {
            title: title,
            theme: title,
            channel_handle: "@thedailyE-shorts",
            duration_seconds: duration,
            viral_score: post.viral_score || 92,
            description: desc || "Relatable comedy short skit.",
            hashtags: post.hashtags || "#shorts #thedailyEshorts #comedy #relatable",
            scenes: [
                {
                    scene_number: 1,
                    start_sec: 0,
                    end_sec: Math.floor(duration / 3),
                    visual_type: "comic_pop_studio",
                    visual_prompt: "Vibrant comic sunburst, emergency calendar alarm alert, pure comedic panic",
                    narration: title + "! That exact split second when reality hits you out of nowhere.",
                    sound_effect: "pop",
                    camera: "zoom_in"
                },
                {
                    scene_number: 2,
                    start_sec: Math.floor(duration / 3),
                    end_sec: Math.floor(duration * 2 / 3),
                    visual_type: "comic_pop_studio",
                    visual_prompt: "Daily panic overthinking, clock spinning fast, funny relatable expression",
                    narration: "Your brain tries to negotiate an escape plan: 'If I don't look at it, maybe it goes away.'",
                    sound_effect: "whoosh",
                    camera: "pan_right"
                },
                {
                    scene_number: 3,
                    start_sec: Math.floor(duration * 2 / 3),
                    end_sec: duration,
                    visual_type: "comic_pop_studio",
                    visual_prompt: "Explosion of comic pop dots, viral subscribe badge bouncing",
                    narration: "Tag that friend who is guilty of this every single week, and hit subscribe on The Daily Shorts!",
                    sound_effect: "sparkle",
                    camera: "pulse"
                }
            ]
        };
    }
}

function openStudioPreview(post) {
    currentModalPost = post;
    const modalEl = document.getElementById('postPreviewModal');
    if (!modalEl) return;
    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);

    document.getElementById('previewPostIdModal').value = post.id;
    document.getElementById('previewPostOriginalStatusModal').value = post.status;
    document.getElementById('previewThemeInput').value = post.theme || "";
    document.getElementById('previewDescriptionModalText').value = post.description || "";
    document.getElementById('previewHashtagsModalText').value = post.hashtags || "";
    document.getElementById('previewTargetAccountModalText').textContent = post.youtube_channel ? (post.youtube_channel.channel_title || post.youtube_channel.username) : "Default Channel";
    document.getElementById('previewTimecodeText').textContent = post.clip_timestamp || (post.duration_seconds ? `00:00 - 00:${post.duration_seconds}` : "Full Video");
    document.getElementById('previewViralScoreText').textContent = (post.viral_score || 90) + "%";
    
    const badgeType = document.getElementById('previewBadgeType');
    const aiSection = document.getElementById('aiLightingScriptSection');

    if (post.post_type === 'ai_video' || (post.approved_theme && post.approved_theme.strategy === 'ai_video')) {
        badgeType.innerHTML = '<span class="badge-ai"><i class="bi bi-stars"></i> Similar AI Video Concept</span>';
        aiSection.style.display = 'block';
        document.getElementById('aiLightingNotesText').textContent = post.ai_lighting_notes || (post.approved_theme ? post.approved_theme.ai_lighting_profile : "Cinematic Rembrandt setup");
        document.getElementById('aiVoiceoverScriptText').textContent = post.ai_voiceover_script || "Voiceover generated script ready for synthesis.";
    } else {
        badgeType.innerHTML = '<span class="badge-shorts"><i class="bi bi-scissors"></i> Shorts Highlights Extract</span>';
        aiSection.style.display = 'none';
    }

    // Load video into canvas engine
    const videoData = synthesizeVideoDataFromPost(post);
    if (modalVideoEngine) {
        modalVideoEngine.loadVideoData(videoData);
        updateModalPlayBtn(false);
    }

    const rescheduleSection = document.getElementById('rescheduleTimeSectionModal');
    const submitBtn = document.getElementById('modalSubmitButton');

    if (post.status === 'pending_approval') {
        rescheduleSection.style.display = 'none';
        submitBtn.textContent = 'Approve & Confirm Upload';
        submitBtn.className = 'btn btn-success fw-bold';
        document.getElementById('editPostFormModal').action = `/post/${post.id}/approve_with_edits`;
    } else {
        rescheduleSection.style.display = 'block';
        submitBtn.textContent = 'Reschedule Upload';
        submitBtn.className = 'btn btn-primary fw-bold';
        document.getElementById('editPostFormModal').action = `/post/${post.id}/reschedule_and_reapprove`;
    }

    modal.show();
}

function openAndPlayPost(post) {
    openStudioPreview(post);
    setTimeout(() => {
        if (modalVideoEngine) {
            modalVideoEngine.seek(0);
            modalVideoEngine.play();
            updateModalPlayBtn(true);
        }
    }, 400);
}

function modalTogglePlay() {
    if (!modalVideoEngine) return;
    const isPlaying = modalVideoEngine.togglePlay();
    updateModalPlayBtn(isPlaying);
}

function updateModalPlayBtn(isPlaying) {
    const icon = document.getElementById('modalPlayBtnIcon');
    const overlay = document.getElementById('modalCanvasPlayOverlay');
    if (icon) {
        icon.className = isPlaying ? 'bi bi-pause-fill' : 'bi bi-play-fill';
    }
    if (overlay) {
        overlay.style.display = isPlaying ? 'none' : 'flex';
    }
}

function modalRestart() {
    if (!modalVideoEngine) return;
    modalVideoEngine.seek(0);
    modalVideoEngine.play();
    updateModalPlayBtn(true);
}

function modalToggleMute() {
    if (!modalVideoEngine) return;
    const muted = modalVideoEngine.toggleMute();
    const icon = document.getElementById('modalMuteBtnIcon');
    if (icon) {
        icon.className = muted ? 'bi bi-volume-mute-fill text-danger' : 'bi bi-volume-up-fill';
    }
}

async function modalExportVideo() {
    if (!modalVideoEngine) return;
    const overlay = document.getElementById('modalExportOverlay');
    const statusText = document.getElementById('modalExportStatus');
    const progressBar = document.getElementById('modalExportProgressBar');
    const percentText = document.getElementById('modalExportPercent');

    overlay.classList.remove('d-none');
    overlay.classList.add('d-flex');

    try {
        await modalVideoEngine.exportVideoAsFile(({ percent, status }) => {
            progressBar.style.width = `${percent}%`;
            statusText.textContent = status;
            percentText.textContent = `${percent}% Complete`;
        });
    } catch (e) {
        alert('Export error: ' + e.message);
    } finally {
        setTimeout(() => {
            overlay.classList.remove('d-flex');
            overlay.classList.add('d-none');
        }, 1200);
    }
}

function quickExportPostVideo(post) {
    openStudioPreview(post);
    setTimeout(() => {
        modalExportVideo();
    }, 500);
}

function requestChanges(postId, postTheme) {
    const suggestions = prompt(`Enter instructions for AI to revise this video/clip "${postTheme || ''}":`, "Make the opening hook punchier and add more contrast to lighting notes");
    if (suggestions !== null && suggestions.trim() !== "") {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = `/post/${postId}/request_changes`;
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'suggestions';
        input.value = suggestions;
        form.appendChild(input);
        document.body.appendChild(form);
        form.submit();
    }
}

function optimizeCurrentModalAlgorithm() {
    const title = document.getElementById('previewThemeInput').value || "Viral Video";
    const isKids = title.toLowerCase().match(/kid|wonder|tale|story|bedtime|pip|pixel|nursery/);
    const isComedy = title.toLowerCase().match(/short|daily|comedy|joke|funny|laugh|vlog|relatable/);

    let hook, synopsis, timestamps, pinned, tags;
    if (isKids) {
        hook = `✨ Can a tiny firefly light up the darkest night? Watch Pip discover courage!`;
        synopsis = `Join Pip on an enchanting bedtime adventure in the Whispering Woods. Teaching toddlers and young children about self-confidence, kindness, and bedtime comfort.`;
        timestamps = `⏱️ Retention Chapters:\n00:00 - The Whispering Forest Hook\n00:15 - Pip's Brave Glow\n00:30 - Bedtime Moral Lesson`;
        pinned = `🌙 Pinned Engagement Question: What makes YOUR little one feel brave at bedtime? Tell us in the comments! 👇`;
        tags = `#shorts, #tiinywondertales, #kidsstories, #bedtimestory, #moralstories`;
    } else if (isComedy) {
        hook = `😂 The exact second you realize adulthood is just deciding what to eat every single day.`;
        synopsis = `Ever had your brain completely glitch on a simple question? We break down the most painfully relatable everyday moments that everyone secretly experiences.`;
        timestamps = `⏱️ Retention Markers:\n00:00 - The Uncomfortable Truth\n00:12 - The Brain Glitch\n00:25 - The Relatable Twist`;
        pinned = `💀 Pinned Engagement Question: Who is that one friend who takes 3 business days to reply? Tag them below! 👇`;
        tags = `#shorts, #thedailyEshorts, #comedy, #relatable, #viralshorts`;
    } else {
        hook = `⚡ The 1 critical mistake that destroys 40% of your daily momentum.`;
        synopsis = `A deep dive into the surprising cognitive protocol top performers use to sustain deep focus without burnout.`;
        timestamps = `⏱️ Retention Markers:\n00:00 - The Overlooked Trap\n00:15 - The Empirical Shift\n00:35 - Actionable Takeaway`;
        pinned = `💬 Pinned Engagement Question: Which of these habits have you tested? Let us know below! 👇`;
        tags = `#shorts, #productivity, #mindset, #lifehacks, #viral`;
    }

    const fullDesc = `${hook}\n\n${synopsis}\n\n${timestamps}\n\n${pinned}`;
    document.getElementById('previewDescriptionModalText').value = fullDesc;
    document.getElementById('previewHashtagsModalText').value = tags;
    
    const badge = document.createElement('div');
    badge.className = 'alert alert-success py-1 px-3 position-fixed top-0 start-50 translate-middle-x mt-4 shadow fw-bold z-3';
    badge.innerHTML = '<i class="bi bi-magic me-1"></i> Re-Optimized Description &amp; Hashtags for YouTube Algorithm Reach!';
    document.body.appendChild(badge);
    setTimeout(() => badge.remove(), 2500);
}
</script>

