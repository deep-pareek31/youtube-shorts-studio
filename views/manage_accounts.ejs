<%- include('partials/header') %>

<div class="mt-2 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-person-video2 text-danger me-2"></i>Connected YouTube Channels</h2>
            <p class="text-muted mb-0">Manage destination YouTube channels where your automated Shorts &amp; AI videos are published.</p>
        </div>
        <a href="/analyze" class="btn btn-yt-red btn-sm"><i class="bi bi-search me-1"></i> Analyze New Channel</a>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-5">
            <div class="yt-card p-4">
                <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-plus-circle text-danger me-2"></i>Connect YouTube Channel</h5>
                <form method="POST" action="/accounts">
                    <div class="mb-3">
                        <label for="channel_title" class="form-label fw-bold">Channel Title:</label>
                        <input type="text" class="form-control" id="channel_title" name="channel_title" placeholder="e.g. Science &amp; Focus Shorts" required>
                    </div>
                    <div class="mb-3">
                        <label for="username" class="form-label fw-bold">Channel Handle / ID:</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">@</span>
                            <input type="text" class="form-control" id="username" name="username" placeholder="e.g. dailyfocus_shorts" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="default_privacy" class="form-label fw-bold">Default Upload Privacy:</label>
                        <select class="form-select" id="default_privacy" name="default_privacy">
                            <option value="public" selected>Public (Instant Live)</option>
                            <option value="unlisted">Unlisted (Review First)</option>
                            <option value="private">Private</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="notes" class="form-label fw-bold">Channel Notes / Niche:</label>
                        <textarea class="form-control" id="notes" name="notes" rows="2" placeholder="e.g. Neuroscience &amp; high performance podcast extracts"></textarea>
                    </div>
                    <button type="submit" class="btn btn-yt-red w-100 fw-bold py-2">
                        <i class="bi bi-check2-circle me-1"></i> Connect YouTube Channel
                    </button>
                </form>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="yt-card p-4">
                <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-collection text-secondary me-2"></i>Active Target Channels (<%= accounts ? accounts.length : 0 %>)</h5>
                <% if (accounts && accounts.length > 0) { %>
                <div class="list-group list-group-flush">
                    <% accounts.forEach(function(acc) { %>
                    <div class="list-group-item p-3 d-flex justify-content-between align-items-center border rounded-3 mb-2 bg-light">
                        <div class="d-flex align-items-center gap-3">
                            <div style="width: 48px; height: 48px; border-radius: 50%; background: #CC0000; color: white; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 20px;">
                                <%= (acc.channel_title || acc.username).charAt(0).toUpperCase() %>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0 text-dark"><%= acc.channel_title || acc.username %></h6>
                                <div class="text-muted small">
                                    <span class="text-danger fw-semibold">@<%= acc.username %></span> &bull; 
                                    <span><%= acc.subscribers || '12.4K' %> Subscribers</span> &bull; 
                                    <span class="badge bg-success-subtle text-success border border-success">Connected</span>
                                </div>
                                <% if (acc.notes) { %>
                                    <div class="text-secondary small mt-1"><em><%= acc.notes %></em></div>
                                <% } %>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <a href="/accounts/<%= acc.id %>/sources" class="btn btn-sm btn-outline-primary" title="Tracked Inspiration Sources">
                                <i class="bi bi-bullseye me-1"></i> Tracked Sources
                            </a>
                            <form method="POST" action="/accounts/<%= acc.id %>/delete" style="display: inline;" onsubmit="return confirm('Remove this YouTube channel?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Disconnect Channel">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                    <% }); %>
                </div>
                <% } else { %>
                <div class="text-muted text-center py-4">No YouTube target channels added yet.</div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
